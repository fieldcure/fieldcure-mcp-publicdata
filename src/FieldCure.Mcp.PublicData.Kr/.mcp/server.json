{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fieldcure/publicdata-kr",
  "description": "Korean public data API gateway for discovering and calling data.go.kr APIs from MCP clients.",
  "version": "1.0.2",
  "repository": {
    "url": "https://github.com/fieldcure/fieldcure-mcp-publicdata",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "FieldCure.Mcp.PublicData.Kr",
      "version": "1.0.2",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DATA_GO_KR_API_KEY",
          "value": "{data_go_kr_api_key}",
          "variables": {
            "data_go_kr_api_key": {
              "description": "data.go.kr API key",
              "isRequired": false,
              "isSecret": true
            }
          }
        },
        {
          "name": "PUBLICDATA_TIMEOUT_SECONDS",
          "value": "{publicdata_timeout_seconds}",
          "variables": {
            "publicdata_timeout_seconds": {
              "description": "Per-request timeout in seconds",
              "isRequired": false,
              "default": "30"
            }
          }
        },
        {
          "name": "PUBLICDATA_MAX_RESPONSE_LENGTH",
          "value": "{publicdata_max_response_length}",
          "variables": {
            "publicdata_max_response_length": {
              "description": "Maximum response body length in characters",
              "isRequired": false,
              "default": "50000"
            }
          }
        }
      ]
    }
  ]
}
