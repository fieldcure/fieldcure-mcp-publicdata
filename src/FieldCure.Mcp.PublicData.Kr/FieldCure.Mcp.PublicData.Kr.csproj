<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FieldCure.Mcp.PublicData.Kr</RootNamespace>
    <AssemblyName>fieldcure-mcp-publicdata-kr</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>1.0.2</Version>
    <PackageId>FieldCure.Mcp.PublicData.Kr</PackageId>

    <Authors>Jong Hyun Kim</Authors>
    <Company>Fieldcure Co., Ltd.</Company>
    <Copyright>Copyright (c) 2026 Fieldcure Co., Ltd.</Copyright>
    <Description>Korean public data MCP server — discover, describe, and call data.go.kr APIs with automatic serviceKey injection, XML-to-JSON conversion, and error mapping.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fieldcure/fieldcure-mcp-publicdata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-mcp-publicdata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;public-data;data-go-kr;korea;openapi;government</PackageTags>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageReleaseNotes>v1.0.2: Harden tool descriptions so models driving invoke_tool-style dispatch (no per-step sub-agent) pick correct arguments — call_api spells out the discover_api→describe_api→call_api workflow, forbids serviceId-as-input, and documents params as a JSON string with a concrete example. No runtime behaviour change.</PackageReleaseNotes>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fieldcure-mcp-publicdata-kr</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="" />
    <None Include="Logo.png" Pack="true" PackagePath="" />
    <None Include=".mcp/server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldCure.Mcp.PublicData.Kr.Tests" />
  </ItemGroup>

  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>.
       The JSON descriptor is metadata for the MCP Server Registry; if the two
       drift, the registry listing reports the wrong version even though the
       published nupkg itself is correct. Runs before pack and errors out on
       the literal token `"version": "$(Version)"` so a mismatched dev pack
       fails immediately with a descriptive message. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))"
           Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>
